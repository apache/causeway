<mb:menuBars
        xsi:schemaLocation="https://causeway.apache.org/applib/layout/menubars/bootstrap3 https://causeway.apache.org/applib/layout/menubars/bootstrap3/menubars.xsd https://causeway.apache.org/applib/layout/component https://causeway.apache.org/applib/layout/component/component.xsd"
        xmlns:cpt="https://causeway.apache.org/applib/layout/component"
        xmlns:mb="https://causeway.apache.org/applib/layout/menubars/bootstrap3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <mb:primary>
        <mb:menu cssClassFa="fa-paw">
            <mb:named>Pet Owners</mb:named>
            <mb:section>
                <mb:named>Manage</mb:named>
                <mb:serviceAction objectType="petclinic.PetOwners" id="create" cssClassFa="fa-user-plus">
                    <cpt:named>Create</cpt:named>
                    <cpt:describedAs>Registers a new pet owner.</cpt:describedAs>
                </mb:serviceAction>
                <mb:serviceAction objectType="petclinic.PetOwners" id="findByName"/>
                <mb:serviceAction objectType="petclinic.PetOwners" id="findByNameLike"/>
                <mb:serviceAction objectType="petclinic.PetOwners" id="listAll" cssClassFa="fa-users" cssClassFaPosition="LEFT">
                    <cpt:named>List All</cpt:named>
                    <cpt:describedAs>Lists every registered pet owner.</cpt:describedAs>
                </mb:serviceAction>
                <mb:serviceAction objectType="petclinic.PetOwners" id="count"/>
            </mb:section>
        </mb:menu>
        <mb:menu cssClassFa="fa-calendar">
            <mb:named>Visits</mb:named>
            <mb:section>
                <mb:named>Schedule</mb:named>
                <mb:serviceAction objectType="petclinic.Visits" id="listUpcoming"/>
            </mb:section>
        </mb:menu>
    </mb:primary>
    <mb:secondary>
        <mb:menu unreferencedActions="true">
            <mb:named>System</mb:named>
        </mb:menu>
    </mb:secondary>
    <mb:tertiary>
        <mb:menu>
            <mb:named>Account</mb:named>
            <mb:section>
                <mb:serviceAction objectType="causeway.applib.UserMenu" id="me"/>
                <mb:serviceAction objectType="causeway.conf.ConfigurationMenu" id="configuration"/>
                <mb:serviceAction objectType="causeway.security.LogoutMenu" id="logout"/>
            </mb:section>
        </mb:menu>
    </mb:tertiary>
</mb:menuBars>
