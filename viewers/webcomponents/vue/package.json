{
  "name": "@apache-causeway/vue-viewer",
  "version": "4.0.0-SNAPSHOT",
  "description": "Router-led Vue integration for Apache Causeway semantic web components",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.adoc",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/causeway-vue.js",
  "module": "./dist/causeway-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/causeway-vue.js"
    },
    "./theme.css": "./dist/causeway-vue.css"
  },
  "scripts": {
    "build": "vite build",
    "check": "vue-tsc --noEmit && vitest run",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "verify": "npm run check && npm run build && node verify-package.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-dts": "5.1.0",
    "vitest": "4.1.11",
    "vue": "3.5.42",
    "vue-router": "4.6.4",
    "vue-tsc": "3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
